# Copy this file to .env and fill in what you need.
# Every value is optional: the app runs with no API keys at all.

# Port the API server listens on in production. Hosting platforms usually set this.
PORT=3001

# Port the API server listens on in dev (`npm run dev`), and the port the Vite dev
# server proxies to. Defaults to 3001. Dev ignores PORT, because tools that run the
# Vite dev server often set PORT for Vite itself.
API_PORT=

# ISO 3166-1 country code used for regional data, e.g. "where to watch" providers.
REGION=BG

# TMDB API key (https://developer.themoviedb.org/). When empty, the movies deck
# uses the local JSON data in data/decks/movies.json.
TMDB_API_KEY=

# Overpass API endpoint for nearby places (OpenStreetMap). No key needed.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# User-Agent sent to OpenStreetMap services (Overpass, Nominatim). Their usage
# policies require one that identifies the app and a way to contact you.
APP_USER_AGENT=WhatNow/0.1 (contact: you@example.com)
